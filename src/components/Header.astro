---
interface Props {
  hasEssays: boolean;
}

const { hasEssays } = Astro.props;
const isCurrent = (href: string) => Astro.url.pathname.replace(/\/?$/, '/').startsWith(href);
---

<header class="site-header">
  <a class="wordmark" href="/">Jacob Jove</a>
  {
    hasEssays && (
      <nav aria-label="Site">
        <a href="/writing/" aria-current={isCurrent('/writing/') ? 'page' : undefined}>
          Writing
        </a>
      </nav>
    )
  }
</header>
