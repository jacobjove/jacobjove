---
interface Props {
  hasEssays: boolean;
}

const { hasEssays } = Astro.props;
const links = [
  { label: 'About', href: '/about/' },
  ...(hasEssays ? [{ label: 'Writing', href: '/writing/' }] : []),
];
const isCurrent = (href: string) => Astro.url.pathname.replace(/\/?$/, '/').startsWith(href);
---

<header class="site-header">
  <a class="wordmark" href="/">Jacob Jove</a>
  <nav aria-label="Site">
    {
      links.map(({ label, href }) => (
        <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
          {label}
        </a>
      ))
    }
  </nav>
</header>
